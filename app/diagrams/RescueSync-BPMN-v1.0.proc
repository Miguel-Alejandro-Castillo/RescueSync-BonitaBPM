          <operations xmi:type="expression:Operation" xmi:id="_wj4gwMgmEfGiAaf72WVgyQ">
            <leftOperand xmi:type="expression:Expression" xmi:id="_wj4gwcgmEfGiAaf72WVgyQ" name="accionSeleccionada" content="accionSeleccionada" type="TYPE_VARIABLE">
              <referencedElements xmi:type="process:Data" xmi:id="_ynDSYMgmEfGiAaf72WVgyQ" name="accionSeleccionada" dataType="_qnkYkKKMEfGM4bfaUYLK2A"/>
            </leftOperand>
            <rightOperand xmi:type="expression:Expression" xmi:id="_wj4gwsgmEfGiAaf72WVgyQ" name="liberarRecursosSegunDecision" content="if (accionSeleccionadaInput == 'ACEPTAR_OFERTAS') return accionSeleccionadaInput&#10;if (!(accionSeleccionadaInput in ['PUBLICAR_CONVOCATORIA', 'GENERAR_LOTES']))&#10;    throw new IllegalArgumentException('Acción desconocida')&#10;import groovy.json.JsonOutput&#10;import groovy.json.JsonSlurper&#10;&#10;def requestJson = { String method, String url, Object body, Map headers -&gt;&#10;    def connection = new URL(url).openConnection()&#10;    connection.requestMethod = method&#10;    connection.connectTimeout = 15000&#10;    connection.readTimeout = 120000&#10;    connection.setRequestProperty('Accept', 'application/json')&#10;    headers.each { k, v -&gt; connection.setRequestProperty(k.toString(), v.toString()) }&#10;    try {&#10;        if (body != null) {&#10;            connection.doOutput = true&#10;            connection.setRequestProperty('Content-Type', 'application/json')&#10;            connection.outputStream.withCloseable { it.write(JsonOutput.toJson(body).getBytes('UTF-8')) }&#10;        }&#10;        if (connection.responseCode &lt; 200 || connection.responseCode &gt;= 300)&#10;            throw new IllegalStateException('Falló la integración HTTP ' + connection.responseCode)&#10;        def text = connection.inputStream.withCloseable { it.getText('UTF-8') }&#10;        return text?.trim() ? new JsonSlurper().parseText(text) : null&#10;    } finally { connection.disconnect() }&#10;}&#10;def backend = api_rescue_url.replaceAll('/+$', '') + '/' + api_rescue_path.replaceAll('^/+|/+$', '')&#10;def loginBackend = requestJson('POST', backend + '/auth/login', [username: api_rescue_user, password: api_rescue_password], [:])&#10;if (!(loginBackend?.access_token instanceof String)) throw new IllegalStateException('El backend no devolvió credencial')&#10;def headersBackend = ['Authorization': 'Bearer ' + loginBackend.access_token]&#10;def nacional = api_nacional_url.replaceAll('/+$', '') + '/' + api_nacional_path.replaceAll('^/+|/+$', '')&#10;def login = requestJson('POST', nacional + '/auth/login', [username: api_nacional_user, password: api_nacional_password], [:])&#10;if (!(login?.data?.access_token instanceof String)) throw new IllegalStateException('La API Nacional no devolvió credencial')&#10;def headersNacional = ['Authorization': 'Bearer ' + login.data.access_token]&#10;def casoUrl = backend + '/integraciones/bonita/casos/' + processInstanceId&#10;&#10;if (!loteIdInput?.isLong() || loteIdInput.toLong() &lt;= 0) throw new IllegalArgumentException('Falta el lote de la decisión')&#10;def reserva = requestJson('GET', casoUrl + '/lotes/' + loteIdInput + '/reservas', null, headersBackend)&#10;def resultado = requestJson('POST', nacional + '/validaciones/reservas/liberar', reserva, headersNacional)?.data&#10;if (resultado?.liberada != true) throw new IllegalStateException('La API Nacional no confirmó la liberación')&#10;return accionSeleccionadaInput&#10;" interpreter="GROOVY" type="TYPE_READ_ONLY_SCRIPT" returnType="java.lang.String" returnTypeFixed="true"><referencedElements xmi:type="process:ContractInput" xmi:id="_mX-Q8MgnEfGiAaf72WVgyQ" name="accionSeleccionadaInput">
                <mapping xmi:type="process:ContractInputMapping" xmi:id="_mX-Q8cgnEfGiAaf72WVgyQ"/>
              </referencedElements><referencedElements xmi:type="parameter:Parameter" xmi:id="_nacional_ref_8" name="api_rescue_url" typeClassname="java.lang.String" /><referencedElements xmi:type="parameter:Parameter" xmi:id="_nacional_ref_9" name="api_rescue_path" typeClassname="java.lang.String" /><referencedElements xmi:type="parameter:Parameter" xmi:id="_nacional_ref_10" name="api_nacional_url" typeClassname="java.lang.String" /><referencedElements xmi:type="parameter:Parameter" xmi:id="_nacional_ref_11" name="api_nacional_path" typeClassname="java.lang.String" /><referencedElements xmi:type="parameter:Parameter" xmi:id="_nacional_ref_12" name="api_nacional_user" typeClassname="java.lang.String" /><referencedElements xmi:type="parameter:Parameter" xmi:id="_nacional_ref_13" name="api_nacional_password" typeClassname="java.lang.String" /><referencedElements xmi:type="expression:Expression" xmi:id="_nacional_ref_14" name="processInstanceId" content="processInstanceId" type="TYPE_ENGINE_CONSTANT" returnType="java.lang.Long" returnTypeFixed="true" /><referencedElements xmi:type="process:ContractInput" xmi:id="_lote_decision_ref" name="loteIdInput"><mapping xmi:type="process:ContractInputMapping" xmi:id="_lote_decision_ref_mapping" /></referencedElements><referencedElements xmi:type="parameter:Parameter" xmi:id="_auth_23b790ff146e4aad9cfeccf38a353b73" name="api_rescue_user" typeClassname="java.lang.String" /><referencedElements xmi:type="parameter:Parameter" xmi:id="_auth_8992b98837fb46c38961c1c8cbda68da" name="api_rescue_password" typeClassname="java.lang.String" /></rightOperand>
            <operator xmi:type="expression:Operator" xmi:id="_wj4gw8gmEfGiAaf72WVgyQ" type="ASSIGNMENT"/>
