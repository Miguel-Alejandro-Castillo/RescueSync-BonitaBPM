<outputs xmi:id="_validation_34c9b38db549415b85545fd152872e06" xmi:type="expression:Operation"><leftOperand xmi:type="expression:Expression" xmi:id="_validation_857e3e774f804c3db5f9e333dc4a8d67" name="esCoberturaSuficiente" content="esCoberturaSuficiente" type="TYPE_VARIABLE" returnType="java.lang.Boolean" returnTypeFixed="true"><referencedElements xmi:type="process:Data" xmi:id="_validation_169b8d90a1c84253882483561c0957d9" name="esCoberturaSuficiente" dataType="_qnkYi6KMEfGM4bfaUYLK2A" /></leftOperand><rightOperand xmi:type="expression:Expression" xmi:id="_validation_d0bd37a7d9134131bb89e5f7d72c3c5f" name="leerCoberturaNacional" content="import groovy.json.JsonOutput&#10;import groovy.json.JsonSlurper&#10;&#10;def solicitud = new JsonSlurper().parseText(bodyAsString)&#10;if (solicitud.ya_validada == true) {&#10;    if (!(solicitud.respuesta_guardada?.cobertura_suficiente instanceof Boolean))&#10;        throw new IllegalStateException('Resultado guardado inválido')&#10;    return solicitud.respuesta_guardada.cobertura_suficiente&#10;}&#10;&#10;def requestJson = { String method, String url, Object body, Map headers -&gt;&#10;    def connection = new URL(url).openConnection()&#10;    connection.requestMethod = method&#10;    connection.connectTimeout = 15000&#10;    connection.readTimeout = 120000&#10;    connection.setRequestProperty('Accept', 'application/json')&#10;    headers.each { k, v -&gt; connection.setRequestProperty(k.toString(), v.toString()) }&#10;    try {&#10;        if (body != null) {&#10;            connection.doOutput = true&#10;            connection.setRequestProperty('Content-Type', 'application/json')&#10;            connection.outputStream.withCloseable { it.write(JsonOutput.toJson(body).getBytes('UTF-8')) }&#10;        }&#10;        if (connection.responseCode &lt; 200 || connection.responseCode &gt;= 300)&#10;            throw new IllegalStateException('Falló la integración HTTP ' + connection.responseCode)&#10;        def text = connection.inputStream.withCloseable { it.getText('UTF-8') }&#10;        return text?.trim() ? new JsonSlurper().parseText(text) : null&#10;    } finally { connection.disconnect() }&#10;}&#10;def headersBackend = ['Authorization': jwt_token_backend]&#10;def backend = api_rescue_url.replaceAll('/+$', '') + '/' + api_rescue_path.replaceAll('^/+|/+$', '')&#10;def nacional = api_nacional_url.replaceAll('/+$', '') + '/' + api_nacional_path.replaceAll('^/+|/+$', '')&#10;def login = requestJson('POST', nacional + '/auth/login', [username: api_nacional_user, password: api_nacional_password], [:])&#10;if (!(login?.data?.access_token instanceof String)) throw new IllegalStateException('La API Nacional no devolvió credencial')&#10;def headersNacional = ['Authorization': 'Bearer ' + login.data.access_token]&#10;def casoUrl = backend + '/integraciones/bonita/casos/' + processInstanceId&#10;&#10;def resultado = requestJson('POST', nacional + '/validaciones/ofertas', solicitud, headersNacional)?.data&#10;if (!(resultado?.resultados instanceof List) || resultado.resultados.any { !(it.estado_validacion in ['valida', 'invalida']) }) throw new IllegalStateException('La API Nacional devolvió una respuesta de validación inválida')&#10;def guardado = requestJson('POST', casoUrl + '/resultado-validacion', resultado, headersBackend)&#10;if (!(guardado?.cobertura_suficiente instanceof Boolean)) throw new IllegalStateException('Respuesta de cobertura inválida')&#10;return guardado.cobertura_suficiente&#10;" interpreter="GROOVY" type="TYPE_READ_ONLY_SCRIPT" returnTypeFixed="true" returnType="java.lang.Boolean"><referencedElements xmi:type="definition:Output" xmi:id="_validation_3bc6ff6f3ea84cd1855ca2e218899759" name="bodyAsString" type="java.lang.String" /><referencedElements xmi:type="parameter:Parameter" xmi:id="_nacional_ref_1" name="api_rescue_url" typeClassname="java.lang.String" /><referencedElements xmi:type="parameter:Parameter" xmi:id="_nacional_ref_2" name="api_rescue_path" typeClassname="java.lang.String" /><referencedElements xmi:type="parameter:Parameter" xmi:id="_nacional_ref_3" name="api_nacional_url" typeClassname="java.lang.String" /><referencedElements xmi:type="parameter:Parameter" xmi:id="_nacional_ref_4" name="api_nacional_path" typeClassname="java.lang.String" /><referencedElements xmi:type="parameter:Parameter" xmi:id="_nacional_ref_5" name="api_nacional_user" typeClassname="java.lang.String" /><referencedElements xmi:type="parameter:Parameter" xmi:id="_nacional_ref_6" name="api_nacional_password" typeClassname="java.lang.String" /><referencedElements xmi:type="expression:Expression" xmi:id="_nacional_ref_7" name="processInstanceId" content="processInstanceId" type="TYPE_ENGINE_CONSTANT" returnType="java.lang.Long" returnTypeFixed="true" /><referencedElements xmi:type="expression:Expression" xmi:id="_auth_981fd4ae8e5c4220a92a149eca6d76df" name="jwt_token_backend" content="jwt_token_backend" type="TYPE_VARIABLE" returnType="java.lang.String" returnTypeFixed="true"><referencedElements xmi:type="process:Data" xmi:id="_auth_981fd4ae8e5c4220a92a149eca6d76df_data" name="jwt_token_backend" dataType="_qnkYkKKMEfGM4bfaUYLK2A" /></referencedElements></rightOperand><operator xmi:id="_validation_9f282c46493741dc967e1de505d20f4a" type="ASSIGNMENT" /></outputs>
</connectors>
