            <leftOperand xmi:type="expression:Expression" xmi:id="_wj4gwcgmEfGiAaf72WVgyQ" name="accionSeleccionada" content="accionSeleccionada" type="TYPE_VARIABLE">
              <referencedElements xmi:type="process:Data" xmi:id="_ynDSYMgmEfGiAaf72WVgyQ" name="accionSeleccionada" dataType="_qnkYkKKMEfGM4bfaUYLK2A"/>
            </leftOperand>
            <rightOperand xmi:type="expression:Expression" xmi:id="_wj4gwsgmEfGiAaf72WVgyQ" name="liberarRecursosSegunDecision" content="if (accionSeleccionadaInput == 'ACEPTAR_OFERTAS') return accionSeleccionadaInput&#xA;if (!(accionSeleccionadaInput in ['PUBLICAR_CONVOCATORIA', 'GENERAR_LOTES']))&#xA;    throw new IllegalArgumentException('Acción desconocida')&#xA;import groovy.json.JsonOutput&#xA;import groovy.json.JsonSlurper&#xA;&#xA;def requestJson = { String method, String url, Object body, Map headers ->&#xA;    def connection = new URL(url).openConnection()&#xA;    connection.requestMethod = method&#xA;    connection.connectTimeout = 15000&#xA;    connection.readTimeout = 120000&#xA;    connection.setRequestProperty('Accept', 'application/json')&#xA;    headers.each { k, v -> connection.setRequestProperty(k.toString(), v.toString()) }&#xA;    try {&#xA;        if (body != null) {&#xA;            connection.doOutput = true&#xA;            connection.setRequestProperty('Content-Type', 'application/json')&#xA;            connection.outputStream.withCloseable { it.write(JsonOutput.toJson(body).getBytes('UTF-8')) }&#xA;        }&#xA;        if (connection.responseCode &lt; 200 || connection.responseCode >= 300)&#xA;            throw new IllegalStateException('Falló la integración HTTP ' + connection.responseCode)&#xA;        def text = connection.inputStream.withCloseable { it.getText('UTF-8') }&#xA;        return text?.trim() ? new JsonSlurper().parseText(text) : null&#xA;    } finally { connection.disconnect() }&#xA;}&#xA;def backend = api_rescue_url.replaceAll('/+$', '') + '/' + api_rescue_path.replaceAll('^/+|/+$', '')&#xA;def loginBackend = requestJson('POST', backend + '/auth/login', [username: api_rescue_user, password: api_rescue_password], [:])&#xA;if (!(loginBackend?.access_token instanceof String)) throw new IllegalStateException('El backend no devolvió credencial')&#xA;def headersBackend = ['Authorization': 'Bearer ' + loginBackend.access_token]&#xA;def nacional = api_nacional_url.replaceAll('/+$', '') + '/' + api_nacional_path.replaceAll('^/+|/+$', '')&#xA;def login = requestJson('POST', nacional + '/auth/login', [username: api_nacional_user, password: api_nacional_password], [:])&#xA;if (!(login?.data?.access_token instanceof String)) throw new IllegalStateException('La API Nacional no devolvió credencial')&#xA;def headersNacional = ['Authorization': 'Bearer ' + login.data.access_token]&#xA;def casoUrl = backend + '/integraciones/bonita/casos/' + processInstanceId&#xA;&#xA;if (loteIdInput?.startsWith('{')) {&#xA;    def decision = new JsonSlurper().parseText(loteIdInput)&#xA;    def reservas = requestJson('POST', casoUrl + '/reservas-decision', decision, headersBackend)&#xA;    if (!(reservas instanceof List)) throw new IllegalStateException('Respuesta de reservas inválida')&#xA;    reservas.each { reserva ->&#xA;        def resultado = requestJson('POST', nacional + '/validaciones/reservas/liberar', reserva, headersNacional)?.data&#xA;        if (resultado?.liberada != true) throw new IllegalStateException('La API Nacional no confirmó la liberación')&#xA;    }&#xA;    requestJson('POST', casoUrl + '/convocatoria-decidida', decision, headersBackend)&#xA;    return accionSeleccionadaInput&#xA;}&#xA;&#xA;if (!loteIdInput?.isLong() || loteIdInput.toLong() &lt;= 0) throw new IllegalArgumentException('Falta el lote de la decisión')&#xA;def reserva = requestJson('GET', casoUrl + '/lotes/' + loteIdInput + '/reservas', null, headersBackend)&#xA;def resultado = requestJson('POST', nacional + '/validaciones/reservas/liberar', reserva, headersNacional)?.data&#xA;if (resultado?.liberada != true) throw new IllegalStateException('La API Nacional no confirmó la liberación')&#xA;return accionSeleccionadaInput&#xA;" interpreter="GROOVY" type="TYPE_READ_ONLY_SCRIPT" returnTypeFixed="true">
